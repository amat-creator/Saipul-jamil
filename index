<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Kejutan Hadiah Pernikahan - Pemuda Biasa</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Sacramento&display=swap" rel="stylesheet">
    
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        emeraldCustom: '#064e3b',
                        goldCustom: '#d97706',
                        goldLight: '#fef3c7',
                        goldAccent: '#f59e0b',
                    },
                    fontFamily: {
                        arabic: ['Amiri', 'serif'],
                        cursive: ['Sacramento', 'cursive'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(180deg, #022c22 0%, #0f172a 45%, #064e3b 80%, #022c22 100%);
            min-height: 100vh;
            color: #f8fafc;
            overflow-x: hidden;
            overscroll-behavior: none;
        }

        .arabic-text {
            font-family: 'Amiri', serif;
            line-height: 1.8;
        }

        /* Animated Gift Box CSS */
        .gift-container {
            perspective: 1000px;
            cursor: pointer;
        }

        .gift-box {
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.5s ease;
        }

        .gift-box:hover {
            transform: scale(1.03) rotateY(5deg);
        }

        .lid {
            transition: transform 0.8s cubic-bezier(0.68, -0.55, 0.27, 1.55);
            transform-origin: bottom back;
        }

        .gift-box.open .lid {
            transform: translateY(-90px) rotateX(40deg) rotateZ(-10deg);
            opacity: 0.8;
        }

        .sparkle-bg {
            background-image: radial-gradient(rgba(255, 215, 0, 0.15) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(2deg); }
        }

        .floating-element {
            animation: float 4s ease-in-out infinite;
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 12px rgba(217, 119, 6, 0.4); }
            50% { box-shadow: 0 0 25px rgba(245, 158, 11, 0.8); }
        }

        .glow-effect {
            animation: pulse-glow 2.5s infinite;
        }

        /* OCEAN & SHIP BACKGROUND ANIMATIONS */
        @keyframes shipSway {
            0%, 100% { transform: translateY(0px) rotate(-2deg); }
            50% { transform: translateY(-5px) rotate(2deg); }
        }

        @keyframes waveMotion1 {
            0%, 100% { transform: translateX(0) scaleY(1); }
            50% { transform: translateX(-15px) scaleY(1.1); }
        }

        @keyframes waveMotion2 {
            0%, 100% { transform: translateX(0) scaleY(1); }
            50% { transform: translateX(15px) scaleY(0.9); }
        }

        .animate-ship {
            animation: shipSway 4s ease-in-out infinite;
        }

        .animate-wave-1 {
            animation: waveMotion1 7s ease-in-out infinite;
        }

        .animate-wave-2 {
            animation: waveMotion2 9s ease-in-out infinite;
        }

        /* Custom Scrollbar */
    <!-- Custom Scrollbar -->
    ::-webkit-scrollbar {
        width: 0px;
    }
</style>
</head>
<body class="relative min-h-screen flex flex-col justify-between items-center p-2 md:p-4 sparkle-bg selection:bg-amber-500 selection:text-white">

<!-- GARIS ORANGE DI SISI KANAN WAKTU DIGESER (UKURAN DIPERKECEIL UNTUK HP) -->
<div class="fixed right-1 md:right-2 top-10 bottom-10 w-1 bg-gradient-to-b from-amber-300 via-amber-500 to-amber-600 rounded-full shadow-[0_0_10px_rgba(245,158,11,0.8)] z-50 pointer-events-none">
    <div id="scrollShip" class="absolute -left-3.5 -top-2 w-8 h-8 flex items-center justify-center transition-transform duration-75 ease-out drop-shadow-[0_0_8px_rgba(245,158,11,1)]">
        <svg viewBox="0 0 100 100" class="w-full h-full animate-ship">
                <defs>
                    <linearGradient id="miniSailGold" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#fffbeb" />
                        <stop offset="50%" stop-color="#f59e0b" />
                        <stop offset="100%" stop-color="#b45309" />
                    </linearGradient>
                </defs>
                <line x1="50" y1="15" x2="50" y2="65" stroke="#78350f" stroke-width="3" />
                <path d="M 50 18 C 75 30 70 52 50 60 Z" fill="url(#miniSailGold)" stroke="#fef3c7" stroke-width="1.5" />
                <path d="M 50 22 C 30 32 35 50 50 58 Z" fill="url(#miniSailGold)" opacity="0.9" stroke="#fef3c7" stroke-width="1.5" />
                <polygon points="50,12 65,17 50,22" fill="#fbbf24" />
                <path d="M 18 62 C 30 62 70 62 82 62 C 75 75 60 82 50 82 C 40 82 25 75 18 62 Z" fill="#b45309" stroke="#fef3c7" stroke-width="2" />
            </svg>
        </div>
    </div>

    <!-- BACKGROUND ANIMATED OCEAN WAVES -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute top-5 left-1/2 -translate-x-1/2 w-60 h-60 bg-gradient-to-b from-amber-200/20 via-emerald-400/10 to-transparent rounded-full blur-3xl opacity-70"></div>
        <div class="absolute bottom-0 left-0 w-[120vw] opacity-60 animate-wave-2 z-0">
            <svg viewBox="0 0 1200 120" class="w-full h-20 fill-emerald-900/80">
                <path d="M0,30 C150,60 350,-10 500,30 C650,70 900,10 1200,40 L1200,120 L0,120 Z"></path>
            </svg>
        </div>
        <div class="absolute bottom-0 left-0 w-[120vw] opacity-90 animate-wave-1 z-0">
            <svg viewBox="0 0 1200 140" class="w-full h-24 fill-slate-950">
                <path d="M0,50 C200,10 400,80 600,40 C800,0 1000,70 1200,30 L1200,140 L0,140 Z"></path>
            </svg>
        </div>
    </div>

    <!-- Floating Audio Control Header -->
    <div class="fixed top-2 left-2 z-50 flex items-center gap-1.5 bg-slate-900/90 backdrop-blur-md border border-amber-500/40 p-1 px-2.5 rounded-full shadow-lg transition-all hover:border-amber-400">
        <button id="musicToggleBtn" onclick="toggleAudio()" class="flex items-center gap-1.5 text-[10px] font-medium text-amber-300 hover:text-amber-100 transition-colors">
            <span id="musicIcon" class="w-5 h-5 rounded-full bg-amber-500/20 flex items-center justify-center text-amber-400 text-[10px]">
                <i class="fa-solid fa-volume-xmark"></i>
            </span>
            <span id="musicStatusText" class="text-[10px]">Musik: Mati</span>
        </button>
    </div>

    <!-- Top Header & Kapal Utama -->
    <header class="text-center mt-6 mb-3 z-10 w-full max-w-sm md:max-w-md flex flex-col items-center">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-900/70 border border-emerald-500/50 text-amber-300 text-[9px] sm:text-[10px] tracking-wider uppercase font-bold mb-1.5 shadow-md">
            <i class="fa-solid fa-calendar-star text-amber-400"></i> Menjelang Acara Tanggal 13 <i class="fa-solid fa-heart text-amber-400 text-[8px]"></i>
        </div>

        <h1 class="text-xl sm:text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-yellow-200 tracking-tight font-sans">
            Syaiful & Nabella
        </h1>
        
        <p class="text-slate-300 text-[10px] sm:text-[11px] mt-0.5 font-light max-w-[260px] sm:max-w-sm">
            Barakallahu Lakuma • Ucapan & doa khusus yang dikirim lebih awal buat kalian berdua!
        </p>

        <!-- VISUAL KAPAL UTAMA (UKURAN LEBIH COMPACT) -->
        <div class="w-36 sm:w-48 h-20 my-1 relative flex justify-center items-center drop-shadow-[0_0_15px_rgba(245,158,11,0.7)] animate-ship">
            <svg viewBox="0 0 500 300" class="w-full h-full">
                <defs>
                    <linearGradient id="mainShipGold" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#fffbeb" />
                        <stop offset="40%" stop-color="#f59e0b" />
                        <stop offset="100%" stop-color="#b45309" />
                    </linearGradient>
                    <linearGradient id="sailGlow" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#fef08a" stop-opacity="1" />
                        <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.85" />
                    </linearGradient>
                </defs>
                <path d="M 245 40 C 300 90 290 190 245 210 C 215 170 215 90 245 40 Z" fill="url(#sailGlow)" stroke="#fef3c7" stroke-width="2.5" />
                <path d="M 160 90 C 205 120 195 195 160 218 C 135 180 140 115 160 90 Z" fill="url(#sailGlow)" opacity="0.95" stroke="#fef3c7" stroke-width="2" />
                <path d="M 320 100 C 360 130 350 195 320 212 C 300 175 300 125 320 100 Z" fill="url(#sailGlow)" opacity="0.9" stroke="#fef3c7" stroke-width="2" />
                <line x1="245" y1="20" x2="245" y2="235" stroke="#78350f" stroke-width="5" />
                <line x1="160" y1="70" x2="160" y2="235" stroke="#78350f" stroke-width="4" />
                <line x1="320" y1="80" x2="320" y2="235" stroke="#78350f" stroke-width="4" />
                <polygon points="245,20 285,28 245,36" fill="#fbbf24" />
                <path d="M 90 215 C 150 215 340 215 405 215 C 375 265 310 280 245 280 C 175 280 120 260 90 215 Z" fill="url(#mainShipGold)" stroke="#fef3c7" stroke-width="3" />
                <path d="M 105 228 C 160 228 335 228 390 228" stroke="#78350f" stroke-width="2.5" />
                <circle cx="170" cy="245" r="6" fill="#fef3c7" />
                <circle cx="210" cy="252" r="6" fill="#fef3c7" />
                <circle cx="250" cy="254" r="6" fill="#fef3c7" />
                <circle cx="290" cy="252" r="6" fill="#fef3c7" />
                <circle cx="330" cy="245" r="6" fill="#fef3c7" />
            </svg>
        </div>

        <!-- COUNTDOWN TIMER -->
        <div class="w-full bg-slate-900/80 backdrop-blur-md border border-amber-500/40 rounded-xl p-2 shadow-lg">
            <p class="text-[9px] text-amber-300 font-bold uppercase tracking-wider mb-1.5">
                <i class="fa-solid fa-hourglass-half mr-1"></i> Hitung Mundur Hari H (Tanggal 13)
            </p>
            <div class="grid grid-cols-4 gap-1.5 text-center">
                <div class="bg-emerald-950/80 border border-emerald-500/30 rounded-lg p-1">
                    <span id="cdDays" class="block text-xs sm:text-sm font-extrabold text-amber-300">00</span>
                    <span class="text-[7px] text-slate-400 uppercase">Hari</span>
                </div>
                <div class="bg-emerald-950/80 border border-emerald-500/30 rounded-lg p-1">
                    <span id="cdHours" class="block text-xs sm:text-sm font-extrabold text-amber-300">00</span>
                    <span class="text-[7px] text-slate-400 uppercase">Jam</span>
                </div>
                <div class="bg-emerald-950/80 border border-emerald-500/30 rounded-lg p-1">
                    <span id="cdMinutes" class="block text-xs sm:text-sm font-extrabold text-amber-300">00</span>
                    <span class="text-[7px] text-slate-400 uppercase">Menit</span>
                </div>
                <div class="bg-emerald-950/80 border border-emerald-500/30 rounded-lg p-1">
                    <span id="cdSeconds" class="block text-xs sm:text-sm font-extrabold text-amber-300">00</span>
                    <span class="text-[7px] text-slate-400 uppercase">Detik</span>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="w-full max-w-[320px] sm:max-w-md flex-grow flex flex-col items-center justify-center my-2 z-10">

        <!-- INITIAL STATE: Gift Box Unopened -->
        <div id="giftSection" class="flex flex-col items-center justify-center text-center transition-all duration-700 w-full">
            <div class="gift-container my-3" onclick="openGift()">
                <div class="absolute -top-7 left-1/2 transform -translate-x-1/2 whitespace-nowrap bg-amber-500 text-slate-950 font-bold text-[9px] sm:text-[10px] px-2.5 py-0.5 rounded-full shadow-md border border-amber-300 flex items-center gap-1.5 animate-bounce">
                    <i class="fa-solid fa-hand-pointer"></i> Klik Kotak Hadiah Ini!
                </div>
                <div id="giftBox" class="gift-box w-28 h-28 sm:w-36 sm:h-36 relative floating-element">
                    <div class="lid absolute -top-2.5 -left-1 w-[calc(100%+8px)] h-7 bg-gradient-to-r from-emerald-700 via-emerald-600 to-emerald-800 rounded-md border-b-2 border-amber-400 shadow-lg z-20 flex items-center justify-center">
                        <div class="absolute w-full h-2 bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500"></div>
                        <div class="absolute -top-3 w-8 h-5 flex justify-center items-center">
                            <div class="w-4 h-4 bg-amber-400 rounded-full border border-yellow-200 transform -rotate-45 shadow"></div>
                            <div class="w-4 h-4 bg-amber-400 rounded-full border border-yellow-200 transform rotate-45 shadow -ml-1.5"></div>
                            <div class="absolute w-2 h-2 bg-yellow-200 rounded-full shadow"></div>
                        </div>
                    </div>
                    <div class="w-full h-full bg-gradient-to-br from-emerald-800 via-emerald-900 to-slate-900 rounded-xl border-2 border-amber-500/50 shadow-xl overflow-hidden relative glow-effect flex items-center justify-center">
                        <div class="absolute w-5 h-full bg-gradient-to-b from-amber-400 via-yellow-300 to-amber-500 shadow"></div>
                        <div class="absolute h-5 w-full bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500 shadow"></div>
                        <div class="relative z-10 bg-slate-950/80 p-2 rounded-full border border-amber-400/80 shadow-inner">
                            <i class="fa-solid fa-gift text-xl sm:text-2xl text-amber-400"></i>
                        </div>
                    </div>
                </div>
            </div>
            <p class="text-[10px] sm:text-[11px] text-slate-300 italic max-w-[240px]">
                "Klik kotak kado ini ya gans, ada ucapan wan doa khusus buat Syaiful & Nabella!"
            </p>
        </div>

        <!-- REVEALED STATE -->
        <div id="cardSection" class="hidden w-full transition-all duration-1000 transform translate-y-6 opacity-0">
            <div class="bg-slate-900/90 backdrop-blur-xl border border-amber-500/40 rounded-2xl p-3 sm:p-5 shadow-xl relative overflow-hidden">
                <div class="absolute top-0 left-0 w-10 h-10 pointer-events-none opacity-20 border-t-2 border-l-2 border-amber-400 rounded-tl-2xl m-1"></div>
                <div class="absolute bottom-0 right-0 w-10 h-10 pointer-events-none opacity-20 border-b-2 border-r-2 border-amber-400 rounded-br-2xl m-1"></div>

                <div class="text-center mb-3">
                    <p class="arabic-text text-lg sm:text-xl text-amber-300 font-bold">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
                    <p class="text-[9px] text-amber-200/70 italic mt-0.5">Dengan Menyebut Nama Allah Yang Maha Pengasih Lagi Maha Penyayang</p>
                </div>

                <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-2.5 text-center mb-3 shadow-inner">
                    <div class="inline-flex items-center gap-1 text-[8px] font-bold text-amber-300 uppercase tracking-wider mb-0.5">
                        <i class="fa-solid fa-paper-plane text-amber-400"></i> Dikirim Lebih Awal
                    </div>
                    <p class="text-[10px] sm:text-[11px] text-slate-200 font-medium leading-relaxed">
                        "Acaranya kan <span class="text-amber-300 font-bold underline decoration-amber-400/50">Tanggal 13</span> nanti, tapi sengaja aku kirim ucapan dan doa ini lebih awal biar kalian makin semangat nyiapin segalanya sampai hari H!"
                    </p>
                </div>

                <div class="bg-emerald-950/70 border border-emerald-500/40 rounded-xl p-2.5 mb-3 shadow-lg">
                    <div class="text-center mb-2">
                        <span class="text-[8px] font-bold text-amber-300 uppercase tracking-widest bg-amber-500/20 px-2 py-0.5 rounded-full border border-amber-400/30">
                            <i class="fa-solid fa-heart mr-1"></i> Pasangan Pengantin
                        </span>
                    </div>
                    <div class="grid grid-cols-1 gap-2">
                        <div class="bg-slate-900/80 border border-amber-500/30 p-2 rounded-lg text-center shadow flex flex-col justify-center">
                            <h4 class="text-sm font-bold text-amber-200 font-sans">Syaiful Zamill</h4>
                            <p class="text-[9px] text-slate-300 mt-0.5 font-light">Putra Pertama dari</p>
                            <p class="text-[9px] text-amber-300/90 font-medium">Bapak Muhammad Zainal Arifin dan Ibu Lia</p>
                        </div>
                        <div class="bg-slate-900/80 border border-amber-500/30 p-2 rounded-lg text-center shadow flex flex-col justify-center">
                            <h4 class="text-sm font-bold text-amber-200 font-sans">Ayudya Nabella</h4>
                            <p class="text-[9px] text-slate-300 mt-0.5 font-light">Putri Pertama dari</p>
                            <p class="text-[9px] text-amber-300/90 font-medium">Bapak Syahrianoor dan Ibu Murnia</p>
                        </div>
                    </div>
                </div>

                <div class="bg-emerald-950/60 border border-emerald-500/30 rounded-xl p-2.5 mb-3 text-center shadow-inner">
                    <p class="arabic-text text-base sm:text-lg text-amber-100 leading-relaxed mb-1">وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً</p>
                    <p class="text-[9px] text-slate-300 font-light leading-relaxed">
                        "Dan di antara tanda-tanda kekuasaan Allah ialah Dia menciptakan pasangan hidup dari jenismu sendiri supaya kamu merasa tenang padanya, dan dijadikan-Nya di antaramu rasa kasih dan sayang."
                    </p>
                    <span class="inline-block mt-1 text-[8px] font-semibold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">
                        QS. Ar-Rum: 21
                    </span>
                </div>

                <div class="text-center my-3 p-3 bg-gradient-to-b from-amber-500/20 via-emerald-950/90 to-slate-950 border border-amber-400/80 rounded-xl shadow-xl relative overflow-hidden backdrop-blur-md">
                    <span class="inline-flex items-center gap-1.5 text-[9px] uppercase tracking-widest text-amber-300 font-bold bg-amber-500/20 px-2.5 py-0.5 rounded-full border border-amber-400/40 mb-1.5">
                        <i class="fa-solid fa-hands-praying text-amber-400"></i> Doa Utama Pernikahan
                    </span>
                    <p class="arabic-text text-lg sm:text-xl text-amber-300 font-extrabold mb-1.5 drop-shadow-[0_2px_8px_rgba(245,158,11,0.6)]">
                        بَارَكَ اللهُ لَكُمَا وَبَارَكَ عَلَيْكُمَا وَجَمَعَ بَيْنَكُمَا فِي خَيْرٍ
                    </p>
                    <div class="inline-block bg-slate-950/70 py-1 px-2 rounded-lg border border-amber-500/30 mb-1.5">
                        <p class="text-[10px] text-amber-200 font-semibold italic">
                            "Barakallahu lakuma wa baraka 'alaikuma wa jama'a bainakuma fii khair."
                        </p>
                    </div>
                    <p class="text-[10px] text-slate-100 max-w-[280px] mx-auto font-medium leading-relaxed">
                        Semoga Allah memberikan keberkahan dan kebahagiaan untuk kalian berdua dalam keadaan senang maupun susah, serta selalu menyatukan kalian dalam kebaikan.
                    </p>
                </div>

                <div class="border-t border-b border-amber-500/20 py-2.5 my-2.5 text-center space-y-1">
                    <h3 class="text-sm font-bold text-amber-200 font-sans">
                        Selamat Membina Keluarga Baru! 💍✨
                    </h3>
                    <p class="text-[10px] text-slate-200 leading-relaxed max-w-[280px] mx-auto">
                        Selamat menjalani hidup baru sebagai suami istri untuk <span class="text-amber-300 font-bold">Syaiful Zamill & Ayudya Nabella</span>. Semoga pernikahan kalian nanti tanggal 13 berjalan lancar, dan rumah tangga kalian selalu dipenuhi kebahagiaan, kedamaian (<span class="text-amber-300 font-medium">Sakinah</span>), rasa cinta (<span class="text-amber-300 font-medium">Mawaddah</span>), dan kasih sayang (<span class="text-amber-300 font-medium">Warahmah</span>) sampai ke surga-Nya.
                    </p>
                </div>

                <div class="mt-3 flex flex-col items-center gap-2 pt-1">
                    <div class="flex items-center justify-center gap-2 bg-amber-500/10 border border-amber-500/30 px-3 py-1.5 rounded-xl w-full">
                        <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-amber-500 to-yellow-300 flex items-center justify-center text-slate-950 font-bold text-[10px] shadow">
                            <i class="fa-solid fa-user-shield text-slate-900"></i>
                        </div>
                        <div class="text-left">
                            <p class="text-[7px] text-amber-400 uppercase tracking-wider font-semibold">Salam & Doa Dari:</p>
                            <p class="text-[11px] font-bold text-amber-200 font-sans">Pemuda Biasa</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 w-full justify-center">
                        <button onclick="triggerFireworks()" class="flex-1 px-2.5 py-1.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-[10px] rounded-lg shadow-md transition-transform active:scale-95 flex items-center justify-center gap-1">
                            <i class="fa-solid fa-sparkles"></i> Kembang Api
                        </button>
                        <button onclick="copyBlessingMessage()" class="flex-1 px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/40 font-bold text-[10px] rounded-lg shadow transition-all flex items-center justify-center gap-1">
                            <i class="fa-solid fa-copy"></i> Salin Doa
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Toast Notification -->
    <div id="toast" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 bg-amber-500 text-slate-950 font-bold text-xs px-4 py-2 rounded-full shadow-2xl z-50 border border-yellow-200 text-center max-w-[90vw]">
        Notification Message
    </div>

    <footer class="text-center text-[10px] text-slate-400 py-2 z-10">
        <p>Dibuat dengan penuh keberkahan • <span class="text-amber-400 font-semibold">Pemuda Biasa</span> © 2026</p>
    </footer>

    <script>
        let isAudioPlaying = false;
        let isGiftOpened = false;

        // Menggunakan link audio dari archive.org yang diberikan
        const bgMusic = new Audio();
        bgMusic.src = 'https://dn711308.ca.archive.org/0/items/jaz-bersamamu-official-lyric-video-128k/Jaz_-_Bersamamu__Official_Lyric_Video_%28128k%29.mp3';
        bgMusic.loop = true;

        // COUNTDOWN TIMER LOGIC
        function initCountdown() {
            const now = new Date();
            let targetYear = now.getFullYear();
            let targetMonth = now.getMonth();
            
            let targetDate = new Date(targetYear, targetMonth, 13, 8, 0, 0);
            
            if (now.getTime() > targetDate.getTime()) {
                targetMonth++;
                if (targetMonth > 11) {
                    targetMonth = 0;
                    targetYear++;
                }
                targetDate = new Date(targetYear, targetMonth, 13, 8, 0, 0);
            }

            function updateTimer() {
                const currentTime = new Date().getTime();
                const difference = targetDate.getTime() - currentTime;

                if (difference <= 0) {
                    document.getElementById('cdDays').innerText = "00";
                    document.getElementById('cdHours').innerText = "00";
                    document.getElementById('cdMinutes').innerText = "00";
                    document.getElementById('cdSeconds').innerText = "00";
                    return;
                }

                const days = Math.floor(difference / (1000 * 60 * 60 * 24));
                const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((difference % (1000 * 60)) / 1000);

                document.getElementById('cdDays').innerText = days < 10 ? '0' + days : days;
                document.getElementById('cdHours').innerText = hours < 10 ? '0' + hours : hours;
                document.getElementById('cdMinutes').innerText = minutes < 10 ? '0' + minutes : minutes;
                document.getElementById('cdSeconds').innerText = seconds < 10 ? '0' + seconds : seconds;
            }

            updateTimer();
            setInterval(updateTimer, 1000);
        }

        function updateScrollShip() {
            const ship = document.getElementById('scrollShip');
            if (!ship) return;
            
            // Ambil posisi scroll (cegah nilai negatif dari efek overscroll/pantulan HP)
            const scrollTop = Math.max(0, window.scrollY || document.documentElement.scrollTop);
            const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            
            let scrollPercent = scrollHeight > 0 ? (scrollTop / scrollHeight) : 0;
            
            // Batasi nilai agar persentase tidak lebih dari 100% (mencegah kapal hilang)
            scrollPercent = Math.max(0, Math.min(1, scrollPercent));
            
            const trackParent = ship.parentElement;
            if (trackParent) {
                // Pastikan tinggi lintasan tidak negatif di layar yang sangat kecil
                const trackHeight = Math.max(0, trackParent.clientHeight - 32); 
                const translateY = scrollPercent * trackHeight;
                ship.style.transform = `translateY(${translateY}px)`;
            }
        }

        window.addEventListener('scroll', updateScrollShip);
        window.addEventListener('resize', updateScrollShip);

        // SINGLETON AUDIO CONTEXT (Efek ledakan)
        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (AudioContextClass) {
                    audioCtx = new AudioContextClass();
                }
            }
            return audioCtx;
        }

        function playExplosionSound() {
            try {
                const ctx = getAudioContext();
                if (!ctx) return;
                
                if (ctx.state === 'suspended') {
                    ctx.resume();
                }

                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, now);
                osc.frequency.exponentialRampToValueAtTime(50, now + 0.2);

                gain.gain.setValueAtTime(1.2, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);

                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.2);

                const bufferSize = ctx.sampleRate * 0.25;
                const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }

                const noise = ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(1400, now);
                filter.frequency.exponentialRampToValueAtTime(200, now + 0.25);

                const noiseGain = ctx.createGain();
                noiseGain.gain.setValueAtTime(0.9, now);
                noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);

                noise.connect(filter);
                filter.connect(noiseGain);
                noiseGain.connect(ctx.destination);

                noise.start(now);
            } catch (e) {
                console.log("Audio synth error:", e);
            }
        }

        // FUNGSI UTAMA BUKA KADO
        function openGift() {
            if (isGiftOpened) return;
            isGiftOpened = true;

            startAudio();
            playExplosionSound();

            const giftBox = document.getElementById('giftBox');
            giftBox.classList.add('open');

            triggerFireworks();

            setTimeout(() => {
                const giftSection = document.getElementById('giftSection');
                const cardSection = document.getElementById('cardSection');

                giftSection.style.display = 'none';
                cardSection.classList.remove('hidden');

                setTimeout(() => {
                    cardSection.classList.remove('translate-y-6', 'opacity-0');
                    cardSection.classList.add('translate-y-0', 'opacity-100');
                    updateScrollShip();
                }, 50);
            }, 700);
        }

        // AUDIO CONTROLS
        function startAudio() {
            bgMusic.play().then(() => {
                isAudioPlaying = true;
                updateAudioUI();
            }).catch(err => {
                console.log("Autoplay diblokir browser:", err);
                isAudioPlaying = false;
                updateAudioUI();
                showToast("⚠️ Silakan klik tombol Musik jika lagu belum berbunyi.");
            });
        }

        function toggleAudio() {
            if (bgMusic.paused) {
                bgMusic.play().then(() => {
                    isAudioPlaying = true;
                    updateAudioUI();
                }).catch(err => {
                    console.log("Play failed:", err);
                    showToast("⚠️ Gagal memutar lagu. Periksa koneksi internet.");
                });
            } else {
                bgMusic.pause();
                isAudioPlaying = false;
                updateAudioUI();
            }
        }

        function updateAudioUI() {
            const icon = document.getElementById('musicIcon');
            const text = document.getElementById('musicStatusText');
            
            if (isAudioPlaying) {
                icon.innerHTML = '<i class="fa-solid fa-volume-high text-amber-400"></i>';
                text.innerText = 'Musik: Menyala';
            } else {
                icon.innerHTML = '<i class="fa-solid fa-volume-xmark text-slate-400"></i>';
                text.innerText = 'Musik: Mati';
            }
        }

        function triggerFireworks() {
            playExplosionSound();

            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 60,
                    spread: 60,
                    origin: { y: 0.6, x: 0.2 },
                    colors: ['#f59e0b', '#d97706', '#10b981', '#ffffff', '#fef3c7']
                });
                confetti({
                    particleCount: 60,
                    spread: 60,
                    origin: { y: 0.6, x: 0.8 },
                    colors: ['#f59e0b', '#d97706', '#10b981', '#ffffff', '#fef3c7']
                });
                setTimeout(() => {
                    playExplosionSound();
                    confetti({
                        particleCount: 90,
                        spread: 80,
                        origin: { y: 0.5 },
                        colors: ['#f59e0b', '#fbbf24', '#34d399', '#ffffff']
                    });
                }, 250);
            }
        }

        // FUNGSI COPY 
        function copyBlessingMessage() {
            const doaText = `بَارَكَ اللهُ لَكُمَا وَبَارَكَ عَلَيْكُمَا وَجَمَعَ بَيْنَكُمَا فِي خَيْرٍ\n\n"Barakallahu lakuma wa baraka 'alaikuma wa jama'a bainakuma fii khair."\n\nSemoga Allah memberikan keberkahan gasan Syaiful Zamill & Ayudya Nabella dalam keadaan senang maupun susah, wan selalu menyatukan kalian dalam kebaikan.\n\nSelamat membina keluarga baru buat acara tanggal 13 nanti!\n\n- Dari: Pemuda Biasa`;
            
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(doaText).then(() => {
                        showToast("Doa & ucapan berhasil disalin! 📋");
                    }).catch(() => fallbackCopy(doaText));
                } else {
                    fallbackCopy(doaText);
                }
            } catch (err) {
                fallbackCopy(doaText);
            }
        }

        function fallbackCopy(text) {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.top = "0";
            textArea.style.left = "0";
            textArea.style.opacity = "0";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
                showToast("Doa & ucapan berhasil disalin! 📋");
            } catch (err) {
                showToast("Gagal menyalin teks.");
            }
            document.body.removeChild(textArea);
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.innerText = message;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        // Initialize on DOM Ready
        document.addEventListener('DOMContentLoaded', () => {
            initCountdown();
            updateScrollShip();

            bgMusic.addEventListener('error', function() {
                console.error("Audio source gagal dimuat.");
                const text = document.getElementById('musicStatusText');
                text.innerText = 'Musik: Error';
            });
        });
    </script>
</body>
</html>
